#!/bin/sh
# 本仓（repo-audit 工具仓）pre-commit 守卫：
# 涉及核心文件改动时强制跑验证链单源（与 CI 完全同源），FAIL 拒绝提交。
# 启用方式：git config core.hooksPath .githooks（本仓已配置）
#
# 历史：此钩子原为 dsh-plugin 模板残留（引用不存在的 scripts/check-deploy.mjs，
# 只因本仓从未提交过 src//scripts/ 路径文件而未引爆）；2026-09-10 替换为本仓验证链。
# 中间态确需跳过：commit --no-verify 并在提交说明注明原因（AGENTS.md 提交规范）。

changed=$(git diff --cached --name-only --diff-filter=ACMR \
        | grep -E '\.(mjs|yaml|yml|json|html)$|^(rules|scripts|templates|docs|test)/' \
        | head -1)
[ -z "$changed" ] && exit 0

echo "pre-commit：检测到核心文件改动（$changed ...），执行验证链 npm run verify ..."
node verify.mjs
code=$?
if [ $code -ne 0 ]; then
  echo ""
  echo "✗ 验证链 FAIL：见上方 ✗ 行。修根因后重试；确属中间态用 --no-verify 并在提交说明注明。"
  exit 1
fi
echo "✓ 验证链通过"
